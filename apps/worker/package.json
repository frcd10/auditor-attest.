{
  "name": "@auditor/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file=../../.env --import tsx src/index.ts",
    "start": "node --env-file=../../.env dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@auditor/attest": "workspace:*",
    "@auditor/db": "workspace:*",
    "@auditor/pricing": "workspace:*",
    "@auditor/report": "workspace:*",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
