# Auditor Attest — environment template.
# Copy to .env and fill in. .env is gitignored; never commit real values.
# Every variable used anywhere in the monorepo is documented here.

# ─── Database ────────────────────────────────────────────────────────────────
# Matches docker-compose.yml. Use a managed Postgres URL in production.
DATABASE_URL=postgresql://auditor:auditor@127.0.0.1:5432/auditor

# ─── Solana (mainnet only; no devnet/localnet anywhere in product code) ──────
CLUSTER=mainnet-beta
# Paid RPC provider endpoint (Helius, Triton, QuickNode...). Never a public RPC in production.
RPC_URL=
# USDC mint on mainnet-beta.
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Wallet (system account) that owns the USDC associated token account receiving payments.
TREASURY_PUBKEY=
# Absolute path to the treasury keypair JSON, OUTSIDE this repo. Only scripts/refund.ts reads it.
TREASURY_KEYPAIR_PATH=
# Absolute path to the attester keypair JSON, OUTSIDE this repo. Signs on-chain attestations (worker + ingest script).
ATTESTER_KEYPAIR_PATH=
# Program id of audit_attest after mainnet deploy (Phase 2). Leave empty until deployed.
AUDIT_ATTEST_PROGRAM_ID=

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Service API key for the `standard` (paid) tier. Read by the worker only, passed to the
# sandbox over stdin for the duration of one job. BYOK jobs never use it.
ANTHROPIC_API_KEY=
# Path to config/models.json (relative to repo root). Change only if you move the file.
MODELS_CONFIG=config/models.json

# ─── Pricing ─────────────────────────────────────────────────────────────────
# Price = estimated LLM cost x MARGIN, rounded up to cents, in USDC.
MARGIN=2.5
# Flat fee for BYOK jobs (user supplies the key; we only charge for attestation + hosting).
ATTEST_FEE_USDC=5
# Hard per-job spend cap = estimated cost x BUDGET_FACTOR. Exceeding it marks the job failed_budget.
BUDGET_FACTOR=1.5
# Multiplier applied to the COSTS.md estimate after calibration against real runs (1.0 = raw formula).
PRICING_CALIBRATION=1.0
# Quotes expire after this many minutes.
QUOTE_TTL_MINUTES=60

# ─── Worker / sandbox ────────────────────────────────────────────────────────
# Local report store root (see README "Report storage contract").
REPORTS_DIR=./reports
# Pinned corpus checkout (git submodule). Mounted read-only into every job container.
CORPUS_DIR=./vendor/auditor-skill
# Corpus version string recorded in meta.json and on-chain.
CORPUS_VERSION=7.3.0@6bb2cbf
# Scratch directory for clones and job outputs (deleted after each job).
JOBS_DIR=/tmp/auditor-jobs
SANDBOX_IMAGE=auditor-sandbox:latest
EGRESS_PROXY_IMAGE=auditor-egress-proxy:latest
# Only these hosts are reachable from inside a job container (via the egress proxy).
EGRESS_ALLOWED_HOSTS=api.anthropic.com
# Wall-clock limit per audit job.
MAX_JOB_MINUTES=180
# Container resource limits.
SANDBOX_MEMORY=4g
SANDBOX_CPUS=2
WORKER_POLL_MS=2000
# 32-byte hex key. BYOK API keys are encrypted with it while they sit in the jobs table between
# submission and pickup, and the ciphertext is wiped the moment the worker claims the job.
# Generate: openssl rand -hex 32
BYOK_KEK=

# ─── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# RPC endpoint the browser wallet code uses (Phase 2). Use an origin-restricted key.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
NEXT_PUBLIC_TREASURY_PUBKEY=
# Dev/admin only: lets the operator enqueue a job without payment from the quote page.
# Generate: openssl rand -hex 24
ADMIN_TOKEN=

# ─── GitHub OAuth (Phase 3: maintainer verification) ─────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate: openssl rand -hex 32
AUTH_SECRET=
